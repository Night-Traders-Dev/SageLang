    # Actually, let's stick to what build.sh did but maybe just build artifacts.
    step_ok("clean")

def update_submodules():
    """
    Initialize first-level submodules without infinite recursion.

    Some submodules (e.g. core/src/sage/vm-tools) vendor their own copy of
    SageLang under .deps/. Naively running `git submodule update --recursive`
    would re-enter that nested SageLang, which contains vm-tools again, and
    recurse forever (vm-tools <-> SageLang circular dependency). We therefore
    update only the top-level submodules of each repo and never descend into
    any path that contains a `.deps` component, since those are self-managed
    vendored dependency trees.
    """
    result = run_cmd(["git", "submodule", "foreach", "--quiet", "echo $name"])
    if not result or not result.stdout:
        return
    names = [n for n in result.stdout.splitlines() if n.strip()]
    for name in names:
        name = name.strip()
        # Resolve the submodule's working path.
        path_res = run_cmd(["git", "submodule", "status", name])
        if not path_res or not path_res.stdout:
            continue
        # `git submodule status` prints a leading char + path (+ optional commit).
        parts = path_res.stdout.split()
        if len(parts) < 2:
            continue
        path = parts[1]
        if ".deps" in Path(path).parts:
            console.print(f"    [dim]skipping nested dep: {path}[/dim]")
            continue
        run_cmd(["git", "submodule", "update", "--init", name])

def compile_shaders(found_deps):
    if found_deps.get("GLSL compiler (glslc)") and Path("core/examples/shaders").exists():
        section("Compiling GLSL shaders to SPIR-V")
        step("Compiling shaders")
        shaders = list(Path("core/examples/shaders").glob("*.vert")) + \
                  list(Path("core/examples/shaders").glob("*.frag")) + \
                  list(Path("core/examples/shaders").glob("*.comp"))
        
        count = 0
        fail = 0
        for s in shaders:
            res = run_cmd(["glslc", str(s), "-o", f"{s}.spv"])
            if res and res.returncode == 0:
                count += 1
            else:
                fail += 1
        
        if fail == 0:
            step_ok(f"{count} modules")
        else:
            step_warn(f"{count} ok, {fail} failed")

def build_sage(args, found_deps):
    use_cmake = found_deps.get("CMake") and not args.make_only
    
    if not use_cmake:
        section("Building with Make")
        step("Compiling sage (C sources)")
        start = time.time()
        res = run_cmd(["make", "-C", "core", "-j" + str(os.cpu_count() or 2)], capture_output=False)
        if res and res.returncode == 0:
            elapsed = int(time.time() - start)
            step_ok(f"{elapsed}s")
        else:
            step_fail("compilation failed")
        return Path("core/sage"), Path("core/sage-lsp")
    else:
        section("Configuring CMake (self-hosted Sage mode)")
        step("Running cmake -DBUILD_SAGE=ON")
        build_dir = Path("core/build_sage")
        build_dir.mkdir(exist_ok=True)
        res = run_cmd(["cmake", "-DBUILD_SAGE=ON", ".."], cwd=build_dir)
        if res and res.returncode == 0:
            step_ok(f"v{VERSION}")
        else:
            step_fail("CMake configuration failed")
            
        section("Building C host interpreter")
        step("Compiling sage (C sources)")
        start = time.time()
        res = run_cmd(["make", "-j" + str(os.cpu_count() or 2), "sage"], cwd=build_dir, capture_output=False)
        if res and res.returncode == 0:
            elapsed = int(time.time() - start)
            step_ok(f"{elapsed}s")
        else:
            step_fail("compilation failed")
            
        return build_dir / "sage", build_dir / "sage-lsp"

