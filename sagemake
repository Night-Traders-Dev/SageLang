def build_trainer(args):
    if not args.train:
        return
    section("Building SL-TQ-LLM C Trainer")
    flags = ""
    libs = "-lm -lpthread"
    
    # Auto-detect cuBLAS
    if Path("/usr/include/cublas_v2.h").exists() or run_cmd("pkg-config --exists cublas", shell=True).returncode == 0:
        flags += " -DUSE_CUBLAS"
        libs += " -lcublas -lcudart"
        console.print("    [bold green]✓[/bold green] cuBLAS GPU acceleration")
    else:
        console.print("    [dim]  cuBLAS not found (CPU only)[/dim]")

    if os.uname().machine == "aarch64":
        flags += " -DUSE_NEON"
        console.print("    [bold green]✓[/bold green] ARM NEON SIMD")

    cmd = f"gcc -O3 -march=native {flags} -o train_sl_tq core/src/c/train_sl_tq.c {libs}"
    res = run_cmd(cmd, shell=True, capture_output=False)
    if res and res.returncode == 0:
        console.print("    [bold green]✓[/bold green] Built: train_sl_tq")
    else:
        console.print("    [bold red]✗[/bold red] Trainer build failed")

def build_selfhost(args, sage_bin):
    """
    Build & verify the self-hosted compiler (bootstrap).

    Uses the C-built host binary to drive the Sage-written toolchain
    (core/src/sage/sage.sage), then proves the self-hosted compiler can
    produce working native binaries: it emits C for a demo program, gcc's
    it, and checks the result matches the C interpreter's output.
    """
    if not args.selfhost:
        return

    banner("Self-Hosted Build (Bootstrap)")
    out_dir = Path("core/build_selfhost")
    out_dir.mkdir(parents=True, exist_ok=True)

    demo_src = out_dir / "demo.sage"
    demo_src.write_text(
        "proc fib(n):\n"
        "    if n <= 1:\n"
        "        return n\n"
        "    return fib(n - 1) + fib(n - 2)\n"
        "let total = 0\n"
        "let i = 0\n"
        "while i < 1000:\n"
        "    total = total + i\n"
        "    i = i + 1\n"
        'print("fib(15) = " + str(fib(15)))\n'
        'print("sum(0..999) = " + str(total))\n'
    )

    # 1) Reference output from the C interpreter
    step("Reference run via C interpreter")
    ref = run_cmd([str(sage_bin), str(demo_src)])
    if not ref or ref.returncode != 0:
        step_fail("C reference run failed")
    step_ok("ok")

    # 2) Self-hosted interpretation of the same program
    section("Self-Hosted Interpretation")
    step("sage.sage running demo through the Sage-written interpreter")
    sh_res = run_cmd(
        [str(sage_bin), "core/src/sage/sage.sage", str(demo_src)],
        capture_output=False,
    )

    # 3) Self-hosted compilation to native: emit-c -> gcc -> execute
    section("Self-Hosted Compilation (emit-c → gcc)")
    c_out = out_dir / "demo_selfhost.c"
    bin_out = out_dir / "demo_selfhosted"
    step("Emitting C via the self-hosted compiler")
    emit = run_cmd(
        [str(sage_bin), "core/src/sage/sage.sage", "--emit-c", str(demo_src),
         "-o", str(c_out)]
    )
    if not emit or emit.returncode != 0 or not c_out.exists():
        step_fail("self-hosted --emit-c failed")
        console.print(emit.stdout[-500:] if emit else "No output")
        return
    step_ok(str(c_out))

    step("Compiling emitted C with gcc")
    cc = run_cmd(
        ["gcc", "-O2", "-o", str(bin_out), str(c_out), "-lm"],
        capture_output=False,
    )
    if not cc or cc.returncode != 0:
        step_fail("gcc failed on self-hosted emitted C")
        return
    step_ok(str(bin_out))

    step("Running native binary")
    native = run_cmd([str(bin_out)])
    if not native or native.returncode != 0:
        step_fail("native run failed")
        return
    step_ok("ok")

    # 4) Parity check
    step("Comparing outputs (interpreter vs compiled)")
    ref_lines = [l for l in (ref.stdout or "").strip().splitlines() if l.strip()]
    nat_lines = [l for l in (native.stdout or "").strip().splitlines() if l.strip()]
    if ref_lines == nat_lines:
        step_ok("outputs identical")
        console.print(f"    [dim]{nat_lines[0] if nat_lines else ''} …[/dim]")
    else:
        step_warn("output mismatch")
        console.print(f"    [red]reference:[/red] {ref_lines}")
        console.print(f"    [red]native   :[/red] {nat_lines}")

    # 5) Full self-hosted test suite
    if not args.skip_tests:
        section("Self-Hosted Test Suite")
        step("make -C core test-selfhost")
        res = run_cmd(["make", "-C", "core", "test-selfhost"], capture_output=False)
        if res and res.returncode == 0:
            step_ok("all suites passed")
        else:
            step_warn("some suites failed")

    # 6) Package the self-hosted compiler as an installable executable.
    # The JIT bundler embeds sage.sage plus every imported module into a
    # copy of the host binary, producing a standalone 'sage' whose
    # implementation is the Sage-written toolchain.
    section("Building Standalone Self-Hosted Compiler")
    sh_bin = out_dir / "sage-selfhosted"
    step("Bundling sage.sage (+ modules) into a standalone executable")
    bundle = run_cmd(
        [str(sage_bin), "--jit", "core/src/sage/sage.sage", "-o", str(sh_bin)],
        capture_output=False,
    )
    if not bundle or bundle.returncode != 0 or not sh_bin.exists():
        step_fail("bundling failed")
        return
    step_ok(f"{sh_bin} ({run_cmd(['du','-h',str(sh_bin)]).stdout.split()[0]})")

    step("Verifying bundled binary version")
    ver = run_cmd([str(sh_bin), "--version"])
    if ver and ver.returncode == 0 and "self-hosted" in (ver.stdout or ""):
        step_ok("reports self-hosted")
    else:
        step_warn("version check inconclusive")

    console.print(f"\n  [dim]Artifacts in {out_dir}/[/dim]")


