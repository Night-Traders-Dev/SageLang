def run_tests(args, sage_bin):
    if args.skip_tests:
        console.print("\n [dim]Tests skipped (--skip-tests)[/dim]")
        return

    banner("Test Suite")
    
    # Sync sage bin to root if needed (tests/run_tests.sh expects it)
    if sage_bin.absolute() != Path("sage").absolute():
        shutil.copy(sage_bin, "sage")
        os.chmod("sage", 0o755)

    section("C Interpreter Tests")
    step("Interpreter tests (241)")
    res = run_cmd(["bash", "core/tests/run_tests.sh"], shell=False)
    if res and res.returncode == 0:
        pass_match = re.search(r'(\d+) passed', res.stdout)
        pass_count = pass_match.group(1) if pass_match else "unknown"
        step_ok(f"{pass_count} passed")
    else:
        step_warn("failed")
        console.print(res.stdout[-500:] if res else "No output")

    section("Self-Hosted Tests")
    step("Full self-hosted suite")
    res = run_cmd(["make", "-C", "core", "test-selfhost"], capture_output=False)
    if res and res.returncode == 0:
        step_ok("all suites passed")
    else:
        step_warn("some tests failed")

def perform_install(args):
    if not args.install:
        console.print(f"\n [dim]To install: python3 sagemake.py --install[/dim]")
        return

    banner("Installation")

    if args.selfhost:
        # Self-hosted install: the bundled Sage-written toolchain becomes
        # 'sage'; the C build is preserved as 'sage-c'.
        sh_bin = Path("core/build_selfhost/sage-selfhosted")
        if not sh_bin.exists():
            step_fail("self-hosted binary missing; run the selfhost build first")
            return

        section("Building release C binary for sage-c")
        step("Compiling sage via Make (release)")
        res = run_cmd(["make", "-C", "core", "-j" + str(os.cpu_count() or 2)], capture_output=False)
        if res and res.returncode == 0:
            step_ok("sage-c source build")
        else:
            step_fail("Make build failed")

        section("Installing SageLang (self-hosted) system-wide")
        console.print("  [yellow]⚙[/yellow] [bold]Installing to /usr/local[/bold]")
        sud = [] if os.geteuid() == 0 else ["sudo"]
        r1 = run_cmd(sud + ["install", "-m", "755", str(sh_bin), "/usr/local/bin/sage"], capture_output=False)
        r2 = run_cmd(sud + ["install", "-m", "755", "core/sage", "/usr/local/bin/sage-c"], capture_output=False)
        if r1 and r1.returncode == 0 and r2 and r2.returncode == 0:
            console.print("  [bold green]✓[/bold green] [green]/usr/local/bin/sage      -> self-hosted toolchain[/green]")
            console.print("  [bold green]✓[/bold green] [green]/usr/local/bin/sage-c    -> C interpreter[/green]")
        else:
            step_fail("Installation failed (sudo required)")
            return

        # Refresh the installed Sage-written compiler modules. A standalone
        # binary bundles its own copies, but it (and any C-host fallback)
        # resolves un-bundled imports from share/sage/src/sage — letting that
        # directory go stale causes version-skew crashes like
        # "Module 'token' has no attribute 'TOKEN_END'".
        section("Refreshing installed self-hosted modules")
        r3 = run_cmd(sud + ["install", "-d", "/usr/local/share/sage/src/sage"], capture_output=False)
        r4 = run_cmd(sud + ["sh", "-c",
                            "install -m 644 core/src/sage/*.sage /usr/local/share/sage/src/sage/"],
                     capture_output=False)
        if r3 and r3.returncode == 0 and r4 and r4.returncode == 0:
            step_ok("/usr/local/share/sage/src/sage updated")
        else:
            step_warn("could not refresh /usr/local/share/sage/src/sage")
        return

    section("Building release binary for installation")
    step("Compiling sage via Make (release)")
    res = run_cmd(["make", "-C", "core", "-j" + str(os.cpu_count() or 2)], capture_output=False)
    if res and res.returncode == 0:
        step_ok("sage + sage-lsp")
    else:
        step_fail("Make build failed")

    section("Installing SageLang system-wide")
    console.print("  [yellow]⚙[/yellow] [bold]Installing to /usr/local[/bold]")
    res = run_cmd(["sudo", "make", "-C", "core", "install"], capture_output=False)
    if res and res.returncode == 0:
        console.print("  [bold green]✓[/bold green] [green]Installed to /usr/local/bin/sage[/green]")
    else:
        step_fail("Installation failed (sudo required)")

