    section("Preparing workspace")
    
    if Path("sagesync").exists() and os.access("sagesync", os.X_OK):
        run_cmd(["./sagesync"], capture_output=False)
    else:
        step("Updating submodules")
        if Path(".git").exists():
            run_cmd(["git", "submodule", "sync"])
